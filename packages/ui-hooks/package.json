{
  "name": "@axiora-ui/ui-hooks",
  "version": "1.0.0",
  "description": "Reusable React hooks for the Axiora UI design system.",
  "author": "axiora-ui",
  "license": "MIT",
  "keywords": [
    "axiora-ui",
    "design-system",
    "react",
    "hooks",
    "use-toggle",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

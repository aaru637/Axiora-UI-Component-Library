{
  "name": "@axiora-ui/ui-tokens",
  "version": "2.0.0",
  "description": "Design tokens for the Axiora UI design system — colors, spacing, and typography.",
  "author": "axiora-ui",
  "license": "MIT",
  "keywords": [
    "axiora-ui",
    "design-system",
    "design-tokens",
    "colors",
    "spacing",
    "typography",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:docs": "typedoc",
    "build:docs:watch": "typedoc --watch"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@axiora-ui/ui-core",
  "version": "1.1.0",
  "description": "Core React UI components for the Axiora UI design system.",
  "author": "axiora-ui",
  "license": "MIT",
  "keywords": [
    "axiora-ui",
    "design-system",
    "react",
    "components",
    "ui",
    "button",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react,react-dom,@axiora-ui/ui-tokens",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@axiora-ui/ui-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

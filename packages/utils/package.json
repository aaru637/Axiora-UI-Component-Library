{
  "name": "@axon/utils",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:docs": "typedoc",
    "build:docs:watch": "typedoc --watch"
  },
  "dependencies": {
    "uuid": "^14.0.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.16"
  }
}

{
  "name": "@axiora-ui/utils",
  "version": "2.0.0",
  "description": "TypeScript utility library for strings, arrays, objects, dates, JSON, and more.",
  "author": "axiora-ui",
  "license": "MIT",
  "keywords": [
    "axiora-ui",
    "utils",
    "utilities",
    "typescript",
    "string",
    "array",
    "object",
    "date",
    "json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:docs": "typedoc",
    "build:docs:watch": "typedoc --watch"
  },
  "dependencies": {
    "uuid": "^14.0.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.16"
  },
  "publishConfig": {
    "access": "public"
  }
}

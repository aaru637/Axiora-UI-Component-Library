{
  "name": "axon-ui-component-library",
  "version": "1.0.0",
  "description": "Axon UI Component Library",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && tsc --noEmit -p tsconfig.json",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:watch": "vitest",
    "build:docs": "turbo run build:docs",
    "build:docs:watch": "turbo run build:docs:watch"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.6.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.4",
    "tsup": "^8.5.0",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "typedoc": "^0.28.5",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}

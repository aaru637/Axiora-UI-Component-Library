{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@axiora-ui/ui-core": ["packages/ui-core/src/index.ts"],
      "@axiora-ui/ui-core/*": ["packages/ui-core/src/*"],
      "@axiora-ui/ui-hooks": ["packages/ui-hooks/src/index.ts"],
      "@axiora-ui/ui-hooks/*": ["packages/ui-hooks/src/*"],
      "@axiora-ui/ui-themes": ["packages/ui-themes/src/index.ts"],
      "@axiora-ui/ui-themes/*": ["packages/ui-themes/src/*"],
      "@axiora-ui/ui-tokens": ["packages/ui-tokens/src/index.ts"],
      "@axiora-ui/ui-tokens/*": ["packages/ui-tokens/src/*"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "exclude": ["**/dist", "**/node_modules", "storybook-static"]
}
